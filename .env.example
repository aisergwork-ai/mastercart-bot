# Токен бота из BotFather
BOT_TOKEN=

# AITUNNEL (Nano Banana / Gemini Image) — примерка карты на фото стены
AITUNNEL_KEY=
# AIMODEL=gemini-3-pro-image-preview

# Админы (Telegram id через запятую). Пусто -> первый /start станет админом.
ADMIN_IDS=
# Чат менеджеров для заявок (можно задать командой /setleadchat в нужном чате)
LEAD_CHAT_ID=

# Лимит бесплатных примерок на пользователя в сутки (0 = без лимита)
MOCKUP_DAILY_LIMIT=5

TZ_NAME=Asia/Yekaterinburg
# На Railway смонтируй Volume в /data и задай:
DB_PATH=data/bot.db

SITE_URL=https://mastercart.shop
BRAND=МастерКарт
